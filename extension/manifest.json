{
  "manifest_version": 3,
  "name": "事实核查AI助手",
  "version": "0.1.0",
  "description": "基于权威信源的事实核查工具，帮助用户快速验证网络信息真实性",
  "author": "事实核查研究项目",
  "homepage_url": "https://github.com/your-repo/fact-check-extension",
  "icons": {
    "16": "public/icon16.png",
    "32": "public/icon32.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png"
  },
  "action": {
    "default_title": "核查选中文本",
    "default_icon": {
      "16": "public/icon16.png",
      "32": "public/icon32.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["dist/content.js"],
      "css": ["dist/content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/*"],
      "matches": ["*://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}