# 应用配置
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# API密钥配置
# 请将以下密钥替换为你的真实密钥
LLM_API_KEY=your_deepseek_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
ZAI_API_KEY=
BOCHA_API_KEY=your_bocha_api_key
TAVILY_API_KEY=your_tavily_api_key

# CORS配置（允许的源）
ALLOWED_ORIGINS=["chrome-extension://*", "http://localhost:3000", "http://127.0.0.1:3000"]

# 搜索配置
MAX_SEARCH_RESULTS=5
SEARCH_TIMEOUT=30

# LLM配置
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.3
