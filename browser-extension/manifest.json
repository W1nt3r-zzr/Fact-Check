{
  "manifest_version": 3,
  "name": "AI信息核查助手",
  "version": "1.0.0",
  "description": "基于GLM-5的智能信息核查工具，帮你快速验证网络信息的真实性",

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "http://localhost:8000/*"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI信息核查助手"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
